{
  /* ────────────────────────────────────────────────────────────────────────────
     HarmonyOS 构建配置
     为「墨迹时光」配置 Stage 模型、Ark 编译选项、目标设备。
     ──────────────────────────────────────────────────────────────────────────── */
  "apiType": "stageMode",
  "buildOption": {
    "arkOptions": {
      "strictMode": "none"
    }
  },
  "targets": [
    {
      "name": "default",
      "runtimeOS": "HarmonyOS"
    }
  ]
}
